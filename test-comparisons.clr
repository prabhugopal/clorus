(println "(< 5 10):" (< 5 10))
(println "(< 10 5):" (< 10 5))
(println "(> 5 10):" (> 5 10))  
(println "(> 10 5):" (> 10 5))
(println "(<= 5 10):" (<= 5 10))
(println "(<= 10 5):" (<= 10 5))
