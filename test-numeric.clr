;; Test floor, ceil, round functions

(defn -main []
  (do
    (println "Testing numeric functions...")

    ;; Test floor
    (println "floor tests:")
    (println (str "  (floor 3.7) => " (floor 3.7)))    ; => 3.0
    (println (str "  (floor 3.0) => " (floor 3.0)))    ; => 3.0
    (println (str "  (floor -3.2) => " (floor -3.2)))  ; => -4.0
    (println (str "  (floor -3.0) => " (floor -3.0)))  ; => -3.0

    ;; Test ceil
    (println "ceil tests:")
    (println (str "  (ceil 3.2) => " (ceil 3.2)))     ; => 4.0
    (println (str "  (ceil 3.0) => " (ceil 3.0)))     ; => 3.0
    (println (str "  (ceil -3.7) => " (ceil -3.7)))   ; => -3.0
    (println (str "  (ceil -3.0) => " (ceil -3.0)))   ; => -3.0

    ;; Test round
    (println "round tests:")
    (println (str "  (round 3.5) => " (round 3.5)))   ; => 4.0
    (println (str "  (round 3.4) => " (round 3.4)))   ; => 3.0
    (println (str "  (round 3.6) => " (round 3.6)))   ; => 4.0
    (println (str "  (round -3.5) => " (round -3.5))) ; => -3.0
    (println (str "  (round -3.6) => " (round -3.6))) ; => -4.0

    (println "All tests completed!")))
