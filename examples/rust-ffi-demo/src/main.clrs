; Test Rust FFI - calling Rust functions from Clorus!
(use rust.example-rust-lib)

; Test basic arithmetic from Rust
(def sum (example-rust-lib/add 10 20))
(def product (example-rust-lib/multiply 6 7))

; Calculate factorial(5) = 120
(def fact (example-rust-lib/factorial 5))

; Test string args/returns across the FFI boundary (regression coverage for
; the CString ownership fix: args and returns must each free their own
; heap-allocated C string exactly once, with no leak and no use-after-free).
(def greeting (example-rust-lib/greet "Clorus"))
(def upper (example-rust-lib/to-upper "seamless rust interop"))
(def len (example-rust-lib/string-length "twelve chars"))

(println greeting)
(println upper)
(println len)

; Repeat calls to surface any double-free/use-after-free from the ownership fix
(dotimes [i 50]
  (example-rust-lib/greet "stress")
  (example-rust-lib/to-upper "stress")
  (example-rust-lib/string-length "stress"))

; Regression coverage: bool FFI args/returns. clorus_value_as_number returns
; 0.0 for a Bool-tagged Value (wrong tag), which used to silently collapse
; both true and false to false when passed as an FFI bool argument.
(def negated-true (example-rust-lib/negate true))
(def negated-false (example-rust-lib/negate false))

; Regression coverage: Option<*mut T> and Result<*mut T, String> -- nil for
; None, a genuine Clorus exception (catchable via try/catch) for Err.
(def counter (example-rust-lib/make-counter 5))
(def missing-counter (example-rust-lib/make-counter -1))
(def checked-counter (example-rust-lib/make-counter-checked 9 false))
(def refused-message
  (try
    (example-rust-lib/make-counter-checked 0 true)
    (catch e (str e))))

; Regression coverage: Rust-interop method-call syntax (lib.Type/method).
; &mut self mutates the real underlying value (not a copy), &self reads it
; back, and the associated function (no receiver) constructs the handle.
(def mc (example-rust-lib.Counter/spawn 0))
(def peek0 (example-rust-lib.Counter/peek mc))
(def bump1 (example-rust-lib.Counter/bump mc))
(def bump2 (example-rust-lib.Counter/bump mc))
(def reset10 (example-rust-lib.Counter/reset mc 10))
(def peek-after (example-rust-lib.Counter/peek mc))

(if (and (= greeting "Hello, Clorus!")
         (= upper "SEAMLESS RUST INTEROP")
         (= len 12)
         (= negated-true false)
         (= negated-false true)
         (= (example-rust-lib/counter-value counter) 5)
         (= missing-counter nil)
         (= (example-rust-lib/counter-value checked-counter) 9)
         (includes? refused-message "refused")
         (= peek0 0)
         (= bump1 1)
         (= bump2 2)
         (= reset10 10)
         (= peek-after 10))
  (do (println "PASS") fact)
  (throw "FFI regression assertion failed"))
