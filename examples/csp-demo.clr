;; ============================================================================
;; CLORUS CSP CONCURRENCY - COMPREHENSIVE EXAMPLE
;; ============================================================================
;; This example demonstrates all CSP features working together:
;; - Channels (buffered message passing)
;; - Go blocks (lightweight concurrency)
;; - Closures (capturing outer scope)
;; - Return channels (promise-like results)
;; - Alts!! (select from multiple channels)
;; ============================================================================

;; Example 1: Basic Go Blocks with Return Channels
;; Go blocks return a channel containing the result

(def task (go (+ 100 200)))
(def result (<!! task))
;; result = 300

;; Example 2: Multiple Concurrent Computations
;; Launch multiple go blocks and collect results

(def t1 (go (* 10 10)))  ;; 100
(def t2 (go (* 20 20)))  ;; 400
(def t3 (go (* 30 30)))  ;; 900

(+ (+ (<!! t1) (<!! t2)) (<!! t3))
;; => 1400

;; Example 3: Go Blocks with Closures
;; Go blocks can capture variables from outer scope

(def multiplier 7)

(def calc1 (go (* multiplier 10)))  ;; Captures multiplier
(def calc2 (go (* multiplier 20)))
(def calc3 (go (* multiplier 30)))

(+ (+ (<!! calc1) (<!! calc2)) (<!! calc3))
;; => 420 (70 + 140 + 210)

;; Example 4: Select with Alts!!
;; Use alts!! to wait on multiple channels

(def ch1 (chan 10))
(def ch2 (chan 10))

(go (>!! ch1 100))
(go (>!! ch2 200))

;; Get first available result
(def result (alts!! [ch1 ch2]))
;; result = [value channel] - e.g., [100 ch1] or [200 ch2]
(nth result 0)
;; => 100 or 200 (whichever arrives first)

;; Example 5: Producer-Consumer with Multiple Channels
;; Multiple producers sending to different channels

(def results1 (chan 10))
(def results2 (chan 10))
(def results3 (chan 10))

;; Launch concurrent producers
(go (>!! results1 42))
(go (>!! results2 84))
(go (>!! results3 126))

;; Consume using alts!!
(def r1 (alts!! [results1 results2 results3]))
(def r2 (alts!! [results1 results2 results3]))
(def r3 (alts!! [results1 results2 results3]))

(+ (+ (nth r1 0) (nth r2 0)) (nth r3 0))
;; => 252 (42 + 84 + 126)

;; Example 6: Complete Integration - All Features Together
;; Demonstrates closures + return channels + alts!!

(def base 5)

;; Go blocks capture 'base', compute results, return channels
(def job1 (go (* base base)))        ;; 25
(def job2 (go (* base base base)))   ;; 125
(def job3 (go (+ base (* base 10)))) ;; 55

;; Use alts!! to collect results as they complete
(def final1 (alts!! [job1 job2 job3]))
(def final2 (alts!! [job1 job2 job3]))
(def final3 (alts!! [job1 job2 job3]))

;; Sum: 25 + 125 + 55 = 205
(+ (+ (nth final1 0) (nth final2 0)) (nth final3 0))

;; ============================================================================
;; This demonstrates a fully functional CSP implementation in Clorus!
;; - Lightweight concurrency with go blocks
;; - Type-safe message passing with channels
;; - Closure capture for flexible async operations
;; - Promise-like return channels
;; - Channel multiplexing with alts!!
;; ============================================================================
