; Test destructuring patterns in Clorus

; Simple vector destructuring
(let [[a b c] [10 20 30]]
  (+ a b c))  ; Should return 60

; Ignore pattern
(let [[a _ c] [1 2 3]]
  (+ a c))  ; Should return 4

; Nested destructuring
(let [[x [y z]] [1 [2 3]]]
  (+ x y z))  ; Should return 6

; Rest parameter
(let [[first & rest] [1 2 3 4 5]]
  first)  ; Should return 1

; Function parameter destructuring
(defn sum-pair [[a b]]
  (+ a b))

(sum-pair [10 20])  ; Should return 30

; Nested function destructuring
(defn process-nested [[x [y z]]]
  (* x (+ y z)))

(process-nested [2 [3 4]])  ; Should return 14
