;; Test while macro
;; (while test body...) => (loop [] (when test body... (recur)))

;; Test 1: Simple while with counter
(def counter (atom 0))

(while (< @counter 5)
  (println "Counter:" @counter)
  (swap! counter inc))

(println "Final counter:" @counter)
;; Expected: prints 0,1,2,3,4 and final value is 5

;; Test 2: While with early termination
(def x (atom 0))

(while (< @x 10)
  (swap! x inc)
  (when (= @x 3)
    (println "Breaking at" @x)))

(println "Final x:" @x)
;; Expected: x reaches 10

;; Test 3: While with multiple statements
(def sum (atom 0))
(def i (atom 1))

(while (<= @i 5)
  (swap! sum (fn [s] (+ s @i)))
  (swap! i inc))

(println "Sum of 1-5:" @sum)
;; Expected: 15
