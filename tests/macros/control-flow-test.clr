;; Test control flow macros

;; Test when macro
(println "Testing when macro:")
(def x 5)
(when (> x 0)
  (println "x is positive")
  (+ x 10))

;; Test when-not macro
(println "Testing when-not macro:")
(when-not (< x 0)
  (println "x is not negative")
  (+ x 20))

;; Test if-let macro
(println "Testing if-let macro:")
(if-let [y 42]
  (println "y is bound to" y)
  (println "y is falsy"))

;; Test when-let macro
(println "Testing when-let macro:")
(when-let [z 100]
  (println "z is bound to" z)
  (+ z 1))

;; Test if-not macro
(println "Testing if-not macro:")
(if-not false
  (println "condition was false")
  (println "condition was true"))

;; Test and macro
(println "Testing and macro:")
(def result1 (and true true true))
(println "and all true:" result1)
(def result2 (and true false true))
(println "and with false:" result2)

;; Test or macro
(println "Testing or macro:")
(def result3 (or false false true))
(println "or with true:" result3)
(def result4 (or false false false))
(println "or all false:" result4)

;; Test some-> macro (thread-first with nil check)
(println "Testing some-> macro:")
(def some-result (some-> 10 (+ 5) (* 2)))
(println "some-> result:" some-result)

;; Test some->> macro (thread-last with nil check)
(println "Testing some->> macro:")
(def some-result2 (some->> [1 2 3] (map inc) (filter (fn [x] (> x 2)))))
(println "some->> result:" some-result2)

;; Test doto macro
(println "Testing doto macro:")
(def obj {:count 0})
(doto obj
  (assoc :name "test")
  (assoc :value 42))

(println "All control flow macro tests completed!")
