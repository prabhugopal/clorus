;; Test exception handling implementation

;; Test 1: Simple throw
(println "Test 1 - Simple throw (this should terminate the program):")

(defn test-throw []
  (throw "Error: Something went wrong!"))

;; Uncomment to test (will terminate):
;; (test-throw)

;; Test 2: Throw with value
(defn divide [x y]
  (if (= y 0)
    (throw "Division by zero!")
    (/ x y)))

(println "Test 2 - Division: 10 / 2 =" (divide 10 2))
(println "Test 2 - Division: 20 / 4 =" (divide 20 4))

;; Uncomment to test exception (will terminate):
;; (println "Test 2 - Division by zero:" (divide 10 0))

;; Test 3: Try/catch (simplified - finally runs)
(defn test-try []
  (try
    (do
      (println "In try block")
      42)
    (catch e
      (println "Caught exception:" e)
      0)
    (finally
      (println "Finally block executed"))))

(println "Test 3 - Try/catch result:" (test-try))

(println "All exception tests completed!")
