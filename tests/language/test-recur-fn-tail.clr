(ns tests.language.test-recur-fn-tail)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn sum-down [n acc]
  (if (zero? n)
    acc
    (recur (dec n) (+ acc n))))

(defn -main [& _args]
  (do
    (assert-eq "defn recur" (sum-down 5 0) 15)
    (letfn [(sum-helper [n acc]
              (if (zero? n)
                acc
                (recur (dec n) (+ acc n))))]
      (assert-eq "letfn recur" (sum-helper 5 0) 15))
    "PASS"))
