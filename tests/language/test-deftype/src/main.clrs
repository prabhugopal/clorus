(ns test-deftype)

;; Test 1: Define a simple type without protocols
(deftype Person [name age])

;; Test 2: Create an instance and verify type metadata
(defn test-type-metadata []
  (let [alice (->Person "Alice" 30)]
    (println "Testing deftype with type metadata...")
    (println (str "  Alice name: " (:name alice)))
    (println (str "  Alice age: " (:age alice)))
    (println (str "  Alice type: " (:__type__ alice)))

    (if (= (:__type__ alice) "Person")
      (println "✓ Type metadata correctly set!")
      (println "✗ Type metadata FAILED!"))

    alice))

;; Test 3: Define a protocol and implement it with deftype
(defprotocol Greetable
  (greet [this] "Greet the entity"))

(deftype Dog [name breed]
  Greetable
  (greet [this]
    (str "Woof! I'm " (:name this) ", a " (:breed this))))

(deftype Cat [name color]
  Greetable
  (greet [this]
    (str "Meow! I'm " (:name this) ", a " (:color this) " cat")))

;; Test 4: Test automatic protocol dispatch
(defn test-protocol-methods []
  (let [dog (->Dog "Rex" "Golden Retriever")
        cat (->Cat "Whiskers" "orange")]
    (println "\nTesting automatic protocol dispatch...")

    (println (str "  Dog: " (:name dog)))
    (println (str "  Dog type: " (:__type__ dog)))
    (println (str "  Greeting: " (greet dog)))

    (println (str "  Cat: " (:name cat)))
    (println (str "  Cat type: " (:__type__ cat)))
    (println (str "  Greeting: " (greet cat)))

    (println "✓ Automatic protocol dispatch works!")))

;; Run tests
(test-type-metadata)
(test-protocol-methods)

;; ============================================================================
;; Test 5: CORAL-style UI Component Protocol
;; ============================================================================

(defprotocol IComponent
  (render [this ctx] "Render the component"))

;; Button component
(deftype Button2 [props state]
  IComponent
  (render [this ctx]
    (str "Button(label=" (:label (:props this)) ", ctx=" ctx ")")))

;; TextField component
(deftype TextField2 [props state]
  IComponent
  (render [this ctx]
    (str "TextField(value=" (:value (:props this)) ", ctx=" ctx ")")))

;; Label component
(deftype Label [props state]
  IComponent
  (render [this ctx]
    (str "Label(text=" (:text (:props this)) ", ctx=" ctx ")")))

;; Test automatic polymorphic dispatch
(defn test-coral-components []
  (let [button (->Button2 {:label "Click Me"} {:hover false})
        textfield (->TextField2 {:value "Hello"} {:focus false})
        label (->Label {:text "Username:"} {})]

    (println "\n============================================")
    (println "Testing CORAL-style UI components...")
    (println "============================================")

    ;; Polymorphic dispatch - automatically calls the right implementation!
    (println (render button "canvas-ctx-1"))
    (println (render textfield "canvas-ctx-2"))
    (println (render label "canvas-ctx-3"))

    (println "\n✓ Polymorphic protocol dispatch works for UI components!")))

(test-coral-components)

