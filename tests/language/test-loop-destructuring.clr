(ns tests.language.test-loop-destructuring)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    ;; A vector pattern remains one recurrence slot: every recur supplies the
    ;; next vector, which is destructured again at the loop head.
    (assert-eq "loop destructures vector bindings on every iteration"
               (loop [[current step] [0 2]]
                 (if (= current 8)
                   current
                   (recur [(+ current step) step])))
               8)

    ;; Map destructuring follows the same rule and exercises dependent locals
    ;; in the recurrence expression.
    (assert-eq "loop destructures map bindings on every iteration"
               (loop [{:keys [index total]} {:index 0 :total 0}]
                 (if (= index 4)
                   total
                   (recur {:index (inc index)
                           :total (+ total index)})))
               6)

    ;; The rest value is fed directly into recur, so the next iteration must
    ;; destructure a sequence result rather than assuming a raw vector.
    (assert-eq "loop reuses vector rest destructuring"
               (loop [[head & tail] [1 2 3]
                      total 0]
                 (if (nil? head)
                   total
                   (recur tail (+ total head))))
               6)

    (assert-eq "vector patterns accept list values"
               (let [[first second & tail] '(1 2 3 4)]
                 (+ first second (count tail)))
               5)

    "PASS"))
