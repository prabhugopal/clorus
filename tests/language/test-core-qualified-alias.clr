;; Ensure clorus.core alias-qualified intrinsic calls compile and run.

(ns tests.language.test-core-qualified-alias
  (:require [clorus.core :as core]))

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "core/dec" (core/dec 5) 4)
    (assert-eq "core/zero? true" (core/zero? 0) true)
    (assert-eq "core/zero? false" (core/zero? 3) false)
    "PASS"))
