;; Test loop/recur for tail recursion

;; Simple countdown loop
(defn countdown [n]
  (loop [i n]
    (if (<= i 0)
      0
      (recur (- i 1)))))

(def result1 (countdown 5))
(def result2 (countdown 10))

;; Factorial using loop/recur
(defn factorial [n]
  (loop [acc 1 n n]
    (if (<= n 1)
      acc
      (recur (* acc n) (- n 1)))))

(def fact5 (factorial 5))
(def fact10 (factorial 10))

;; Sum using loop/recur
(defn sum-to-n [n]
  (loop [acc 0 i 1]
    (if (> i n)
      acc
      (recur (+ acc i) (+ i 1)))))

(def sum10 (sum-to-n 10))
(def sum100 (sum-to-n 100))
