;; Comprehensive test: Go blocks with closures AND return channels
;; Demonstrates the full power of the CSP implementation

(def multiplier 7)

;; Launch go blocks that capture 'multiplier' and return results
(def task1 (go (* multiplier 10)))   ;; 70
(def task2 (go (* multiplier 20)))   ;; 140
(def task3 (go (* multiplier 30)))   ;; 210

;; Use alts!! to get results as they become available
(def result1 (alts!! [task1 task2 task3]))
(def result2 (alts!! [task1 task2 task3]))
(def result3 (alts!! [task1 task2 task3]))

;; Sum all values: 70 + 140 + 210 = 420
(+ (+ (nth result1 0) (nth result2 0)) (nth result3 0))
