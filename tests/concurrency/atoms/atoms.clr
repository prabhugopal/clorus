(println "Testing basic atom operations:")
(def counter (atom 5))
(println (str "Initial: " @counter))
(reset\! counter 10)
(println (str "After reset: " @counter))
(println "Expected: 10")
(def counter (atom 5))
(println @counter)
(def counter (atom 0))
(swap\! counter (fn [x] (+ x 1)))
(println @counter)
(def counter (atom 5))
(println (str "Initial: " @counter))
(def doubler (fn [x] (* x 2)))
(swap\! counter doubler)
(println (str "After swap: " @counter))
(println "Expected: 10")
;; Test swap! with static function
(println "Testing swap! with static function...")

(defn my-doubler [x] (* x 2))

(def counter (atom 5))
(println "Initial:")
(println @counter)

(swap! counter my-doubler)
(println "After swap! with static function:")
(println @counter)
(println "Expected: 10")

"Done"
;; Test swap\! with inline closure
(println "Testing swap with inline closure...")

(def counter (atom 5))
(println "Initial:")
(println @counter)

(swap\! counter (fn [x] (* x 2)))
(println "After swap:")
(println @counter)
(println "Expected: 10")

"Done"
(def state (atom {:count 0}))
(println @state)
