;; Define a protocol with multiple methods
(defprotocol Drawable
  (draw [this] "Draw the object")
  (area [this] "Calculate area"))

;; Define record types
(defrecord Point [x y])
(defrecord Circle [x y radius])

;; Implement protocol for Point
(extend-type Point
  Drawable
  (draw [this]
    (+ (get this :x) (get this :y)))
  (area [this]
    0))

;; Implement protocol for Circle
(extend-type Circle
  Drawable
  (draw [this]
    (get this :radius))
  (area [this]
    (* (get this :radius) (get this :radius))))

;; Test protocol methods
(do
  (def p (->Point 10 20))
  (def c (->Circle 0 0 5))

  (def point-draw (Point_Drawable_draw p))   ;; Should return 30
  (def point-area (Point_Drawable_area p))   ;; Should return 0
  (def circle-draw (Circle_Drawable_draw c)) ;; Should return 5
  (def circle-area (Circle_Drawable_area c)) ;; Should return 25

  ;; Return sum to verify all work
  (+ point-draw point-area circle-draw circle-area)) ;; Should return 60
