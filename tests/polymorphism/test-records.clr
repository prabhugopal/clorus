;; Test 1: Define a simple record
(defrecord Person [name age])

;; Test 2: Create a record instance using the constructor
(def alice (->Person "Alice" 30))

;; Test 3: Access fields using keywords
(:name alice)

;; Test 4: Access another field
(:age alice)

;; Test 5: Create another instance
(def bob (->Person "Bob" 25))

;; Test 6: Access Bob's fields
(:name bob)
