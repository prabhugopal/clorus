;; Test partition-by with higher-order function
(defn even? [n]
  (= (mod n 2) 0))

;; Test with simple predicate
(count (partition-by even? [1 1 2 2 3 3]))
;; Test partition-by with first-class functions

;; Copy partition-by from stdlib
(defn partition-by [f coll]
  (if (empty? coll)
    []
    (let [first-val (first coll)
          first-result (f first-val)]
      ;; Helper function to take while f returns same value
      (let [take-same (fn take-same [fval xs]
                        (if (empty? xs)
                          []
                          (let [x (first xs)]
                            (if (= (f x) fval)
                              (conj (take-same fval (rest xs)) x)
                              []))))
            ;; Helper function to drop while f returns same value
            drop-same (fn drop-same [fval xs]
                        (if (empty? xs)
                          []
                          (let [x (first xs)]
                            (if (= (f x) fval)
                              (drop-same fval (rest xs))
                              xs))))
            ;; Get first partition
            chunk (conj (take-same first-result (rest coll)) first-val)
            ;; Get remaining elements
            remaining (drop-same first-result (rest coll))]
        (if (empty? remaining)
          [chunk]
          (conj (partition-by f remaining) chunk))))))

;; Test with defn'd function
(defn less-than-3 [x] (< x 3))
(partition-by less-than-3 [1 2 3 4 2 1])
;; Test filter without recursion - just test first element

(defn is-positive [x] (> x 0))

(defn test-pred [f x]
  (if (f x)
    x
    0))

(test-pred is-positive 5)
;; Test map with different function types

;; 1. Test map with a defn'd function
(defn add-one [x]
  (+ x 1))

(def result1 (map add-one [1 2 3]))

result1
;; Test basic reduce to make sure it works
(defn add [a b]
  (+ a b))

(reduce add 0 [1 2 3 4 5])
