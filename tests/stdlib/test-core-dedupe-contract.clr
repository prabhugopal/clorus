(ns tests.stdlib.test-core-dedupe-contract)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    ;; `distinct` and eager `dedupe` expose finite results as sequences.
    (assert-eq "distinct values" (distinct [1 2 1 3 2]) '(1 2 3))
    (assert-eq "distinct sequence" (seq? (distinct [1 1])) true)
    (assert-eq "dedupe values" (dedupe [1 1 2 2 3 1 1]) '(1 2 3 1))
    (assert-eq "dedupe sequence" (seq? (dedupe [1 1])) true)
    (assert-eq "dedupe empty" (dedupe []) '())
    (assert-eq "dedupe nil elements" (dedupe [nil nil 1 nil nil]) (list nil 1 nil))
    (println "core dedupe contract passed")))
