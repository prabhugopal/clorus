(ns tests.stdlib.test-core-set)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "deduplicates values" (set [1 2 3 1]) #{1 2 3})
    (assert-eq "accepts nil as an empty collection" (set nil) #{})
    (assert-eq "works with a list" (set '(1 2 1)) #{1 2})
    "PASS"))
