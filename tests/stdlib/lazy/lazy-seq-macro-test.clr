; Test lazy-seq macro
(ns test-lazy-seq)

(defn -main []
  (do
    (println "Testing lazy-seq macro...")

    ; Test basic lazy-seq
    (let [simple-lazy (lazy-seq (cons 1 nil))]
      (do
        (println "\nSimple lazy-seq:")
        (println "First:")
        (println (clorus.lazy/lazy-first simple-lazy))))

    ; Test lazy-seq with computation
    (defn my-lazy-range [n]
      (lazy-seq
        (if (< n 1)
          nil
          (clorus.lazy/lazy-cons n (my-lazy-range (- n 1))))))

    (let [nums (my-lazy-range 5)]
      (do
        (println "\nLazy range 1-5:")
        (println "First:")
        (println (clorus.lazy/lazy-first nums))
        (println "Count:")
        (println (clorus.lazy/lazy-count nums))))

    (println "\nlazy-seq macro works!")))
