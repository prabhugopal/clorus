(ns tests.stdlib.test-core-long-tail-1)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn assert-vec [label actual expected]
  (do
    (assert-eq (str label " count") (count actual) (count expected))
    (loop [i 0]
      (if (< i (count expected))
        (do
          (assert-eq (str label " idx=" i) (nth actual i) (nth expected i))
          (recur (+ i 1)))
        true))))

(defn -main [& _args]
  (do
    ;; function/predicate helpers
    (assert-eq "int trunc +" (int 3.7) 3.0)
    (assert-eq "int trunc -" (int -3.7) -3.0)
    (assert-eq "identity" (identity 42) 42)
    (let [kfn (constantly :k)
          ceven (complement even?)
          jfn (juxt inc dec)]
      (assert-eq "constantly" (kfn 1 2 3) :k)
      (assert-eq "complement" (ceven 3) true)
      (assert-vec "juxt" (jfn 5) [6 4]))
    (assert-eq "some? nil" (some? nil) false)
    (assert-eq "some? value" (some? 0) true)
    (assert-eq "zero? true" (zero? 0) true)
    (assert-eq "zero? false" (zero? 2) false)
    (assert-eq "pos? true" (pos? 2) true)
    (assert-eq "not-empty empty" (not-empty []) nil)
    (assert-vec "not-empty vec" (not-empty [1 2]) [1 2])
    (assert-eq "boolean nil" (boolean nil) false)
    (assert-eq "boolean val" (boolean 1) true)
    (assert-eq "true?" (true? true) true)
    (assert-eq "false?" (false? false) true)
    (assert-eq "symbol?" (symbol? 'abc) true)
    (assert-eq "bool? alias" (bool? true) true)

    ;; map/collection helpers
    (assert-eq "zipmap :a" (get (zipmap [:a :b] [1 2]) :a nil) 1)
    (assert-eq "frequencies 1" (get (frequencies [1 2 1 3 1]) 1 0) 3)
    (assert-vec "group-by true"
                (get (group-by even? [1 2 3 4]) true [])
                [2 4])
    (assert-vec "partition"
                (partition 2 [1 2 3 4])
                [[1 2] [3 4]])
    (assert-vec "partition-all"
                (partition-all 2 [1 2 3])
                [[1 2] [3]])
    (assert-vec "take-while"
                (take-while (fn [x] (< x 4)) [1 2 3 5 1])
                [1 2 3])
    (assert-vec "drop-while"
                (drop-while (fn [x] (< x 4)) [1 2 3 5 1])
                [5 1])
    (assert-vec "split-at left"
                (first (split-at 2 [1 2 3 4]))
                [1 2])
    (assert-vec "split-at right"
                (second (split-at 2 [1 2 3 4]))
                [3 4])
    (assert-vec "split-with left"
                (first (split-with (fn [x] (< x 4)) [1 2 4 5]))
                [1 2])
    (assert-vec "split-with right"
                (second (split-with (fn [x] (< x 4)) [1 2 4 5]))
                [4 5])
    (assert-eq "invert-map" (get (invert-map {:a 1 :b 2}) 1 nil) :a)

    ;; numeric/seq helpers
    (assert-eq "abs" (abs -5) 5)
    (assert-eq "min" (min 3 1 2) 1)
    (assert-eq "max" (max 3 1 2) 3)
    (assert-eq "rem" (rem 7 3) 1)
    (assert-eq "second" (second [10 20 30]) 20)
    (assert-eq "third" (third [10 20 30]) 30)
    (assert-eq "ffirst" (ffirst [[1 2] [3 4]]) 1)
    (assert-vec "nfirst" (nfirst [[1 2 3] [4 5]]) [2 3])
    (assert-eq "fnext" (fnext [10 20 30]) 20)
    (assert-vec "nnext" (nnext [10 20 30 40]) [30 40])
    (assert-vec "butlast" (butlast [1 2 3]) [1 2])
    (assert-vec "sort" (sort [3 1 2]) [1 2 3])
    (assert-vec "sort-by"
                (sort-by (fn [x] (nth x 0)) [[2 "b"] [1 "a"]])
                [[1 "a"] [2 "b"]])
    (assert-vec "repeatedly" (repeatedly 3 (fn [] 7)) [7 7 7])
    (assert-vec "remove" (remove odd? [1 2 3 4]) [2 4])
    "PASS"))
