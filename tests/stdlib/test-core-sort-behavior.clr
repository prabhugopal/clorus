(ns tests.stdlib.test-core-sort-behavior)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn assert-vec [label actual expected]
  (do
    (assert-eq (str label " count") (count actual) (count expected))
    (loop [i 0]
      (if (< i (count expected))
        (do
          (assert-eq (str label " idx=" i) (nth actual i) (nth expected i))
          (recur (+ i 1)))
        true))))

(defn -main [& _args]
  (do
    (assert-vec "sort ints" (sort [3 1 2 1]) [1 1 2 3])
    (assert-vec "sort comparator descending" (sort > [3 1 2 1]) [3 2 1 1])
    (assert-vec "sort comparator compare-style numeric"
                (sort (fn [a b] (- a b)) [3 1 2 1])
                [1 1 2 3])
    (assert-vec "sort negatives" (sort [0 -5 2 -1]) [-5 -1 0 2])
    (assert-vec "sort doubles" (sort [2.5 1.2 1.1]) [1.1 1.2 2.5])

    (assert-vec "sort-by numeric keys"
                (sort-by (fn [x] (nth x 0)) [[2 "b"] [1 "a"] [3 "c"]])
                [[1 "a"] [2 "b"] [3 "c"]])
    (assert-vec "sort-by comparator descending keys"
                (sort-by (fn [x] (nth x 0)) > [[2 "b"] [1 "a"] [3 "c"]])
                [[3 "c"] [2 "b"] [1 "a"]])
    (assert-vec "sort-by compare-style numeric keys"
                (sort-by (fn [x] (nth x 0))
                         (fn [a b] (- a b))
                         [[2 "b"] [1 "a"] [3 "c"]])
                [[1 "a"] [2 "b"] [3 "c"]])
    (assert-vec "sort-by duplicate keys keeps partition order"
                (sort-by (fn [x] (nth x 0)) [[2 "b"] [1 "a"] [1 "x"] [3 "c"]])
                [[1 "a"] [1 "x"] [2 "b"] [3 "c"]])
    (assert-vec "sort-by comparator stability on equal keys"
                (sort-by (fn [x] (nth x 0)) > [[2 "b"] [1 "a"] [1 "x"] [3 "c"]])
                [[3 "c"] [2 "b"] [1 "a"] [1 "x"]])
    (assert-vec "sort-by stability across halves"
                (sort-by (fn [x] (nth x 0))
                         [[1 "a"] [2 "b"] [1 "c"] [2 "d"] [1 "e"] [2 "f"]])
                [[1 "a"] [1 "c"] [1 "e"] [2 "b"] [2 "d"] [2 "f"]])
    "PASS"))
