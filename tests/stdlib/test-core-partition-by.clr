(ns tests.stdlib.test-core-partition-by)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "partition-by empty"
               (partition-by odd? [])
               [])
    (assert-eq "partition-by single"
               (partition-by odd? [1])
               [[1]])
    (assert-eq "partition-by alternating"
               (partition-by odd? [1 2 3 4 5 6])
               [[1] [2] [3] [4] [5] [6]])
    (assert-eq "partition-by grouped runs"
               (partition-by odd? [1 3 5 2 4 7 9 10])
               [[1 3 5] [2 4] [7 9] [10]])
    (assert-eq "partition-by keyfn change points"
               (partition-by (fn [x] (if (< x 3) :small :big))
                             [1 2 3 4 1 2 9])
               [[1 2] [3 4] [1 2] [9]])
    "PASS"))
