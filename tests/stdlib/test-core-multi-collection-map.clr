(ns tests.stdlib.test-core-multi-collection-map)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "map stops at the shortest collection"
               (map + [1 2 3] [10 20])
               '(11 22))
    (assert-eq "map supports three collections"
               (map (fn [a b c] (+ a b c)) [1 2] [10 20] [100 200])
               '(111 222))
    (assert-eq "map leaves its multi-input tail deferred"
               (let [calls (atom 0)
                     xs (map (fn [a b] (do (swap! calls inc) (+ a b)))
                             [1 2 3]
                             [10 20 30])]
                 (if (= @calls 0)
                   (if (= (first xs) 11)
                     @calls
                     :wrong-value)
                   :eager))
               1)
    (assert-eq "mapv realizes multi-input map into a vector"
               (mapv + [1 2 3] [10 20])
               [11 22])
    (assert-eq "mapcat supports multiple collections"
               (mapcat (fn [a b] [a b]) [1 2 3] [:a :b])
               '(1 :a 2 :b))
    (assert-eq "mapcat stops at the shortest collection"
               (mapcat vector [1 2 3] [:a :b])
               '(1 :a 2 :b))
    "PASS"))
