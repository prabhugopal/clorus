(ns tests.stdlib.test-core-vec)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "vector input is preserved" (vec [1 2 3]) [1 2 3])
    (assert-eq "list input realizes in order" (vec '(1 2 3)) [1 2 3])
    (assert-eq "nil realizes as an empty vector" (vec nil) [])
    "PASS"))
