(ns tests.stdlib.test-core-ordering)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn assert-vec [label actual expected]
  (do
    (assert-eq (str label " count") (count actual) (count expected))
    (loop [i 0]
      (if (< i (count expected))
        (do
          (assert-eq (str label " idx=" i) (nth actual i) (nth expected i))
          (recur (+ i 1)))
        true))))

(defn -main [& _args]
  (do
    (assert-vec "map order" (map #(* % 2) [1 2 3 4]) [2 4 6 8])
    (assert-vec "filter order" (filter odd? [1 2 3 4 5]) [1 3 5])
    (assert-vec "take order" (take 3 [10 20 30 40]) [10 20 30])
    (assert-vec "drop order" (drop 2 [10 20 30 40]) [30 40])
    "PASS"))
