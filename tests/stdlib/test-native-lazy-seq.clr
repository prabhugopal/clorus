(ns tests.stdlib.test-native-lazy-seq)

(defn assert-eq [label expected actual]
  (when (not (= expected actual))
    (throw (str label " expected=" expected " actual=" actual))))

;; Construction must not run the body. `first` is the forcing boundary and
;; repeated traversal must use the cached result rather than invoke it again.
(let [calls (atom 0)
      xs (lazy-seq
           (swap! calls inc)
           (list 10 20))]
  (assert-eq "lazy-seq is initially unforced" 0 @calls)
  (assert-eq "lazy-seq satisfies seq?" true (seq? xs))
  (assert-eq "first forces lazy-seq" 10 (first xs))
  (assert-eq "lazy-seq force count" 1 @calls)
  (assert-eq "first uses cached lazy-seq" 10 (first xs))
  (assert-eq "lazy-seq is forced once" 1 @calls)
  (assert-eq "rest traverses cached lazy-seq" 20 (first (rest xs))))

;; A sequenceable collection realizes to the canonical list representation,
;; exactly as `seq` does for a non-lazy collection.
(let [xs (lazy-seq [30 40])]
  (assert-eq "lazy-seq seq normalizes vectors" true (list? (seq xs)))
  (assert-eq "lazy-seq normalized first" 30 (first xs)))

;; Core transforms use `empty?` internally. Its sequence boundary must force
;; only what traversal requires instead of treating an unresolved value as
;; count-zero.
(let [xs (lazy-seq (list 1 2 3))]
  (assert-eq "lazy-seq is not empty" false (empty? xs))
  (assert-eq "take traverses lazy-seq" [1 2] (take 2 xs))
  (assert-eq "drop traverses lazy-seq" 3 (first (drop 2 xs)))
  (assert-eq "count traverses lazy-seq" 3 (count xs))
  (assert-eq "nth traverses lazy-seq" 2 (nth xs 1))
  (assert-eq "last traverses lazy-seq" 3 (last xs)))

(assert-eq "lazy-seq rejects non-sequence bodies"
           true
           (try
             (do
               (first (lazy-seq 42))
               false)
             (catch e (string? e))))

(assert-eq "lazy count propagates thunk errors"
           true
           (try
             (do
               (count (lazy-seq 42))
               false)
             (catch e (string? e))))

;; `seq` is also a forcing boundary and an empty body result becomes nil.
(let [calls (atom 0)
      xs (lazy-seq
           (swap! calls inc)
           nil)]
  (assert-eq "seq forces lazy-seq" nil (seq xs))
  (assert-eq "seq realizes once" 1 @calls))

;; A sequence node keeps its tail lazy. This is the first unbounded producer:
;; consuming a finite prefix must neither precompute nor print the rest.
(let [xs (range)]
  (assert-eq "zero-arity range is a sequence" true (seq? xs))
  (assert-eq "zero-arity range starts at zero" 0 (first xs))
  (assert-eq "nth traverses lazy range" 4 (nth xs 4))
  (assert-eq "take bounds lazy range" [0 1 2 3 4] (take 5 xs))
  (assert-eq "drop preserves lazy range tail" [3 4 5] (take 3 (drop 3 xs))))

;; Exercise finite general steps too: `count` and `last` must traverse a lazy
;; tail iteratively, while `rest` preserves the tail instead of materializing.
(let [xs (lazy-seq
           (__clorus_seq_cons 1
                              (lazy-seq (__clorus_seq_cons 2 nil))))]
  (assert-eq "general sequence step count" 2 (count xs))
  (assert-eq "general sequence step last" 2 (last xs))
  (assert-eq "general sequence step rest" 2 (first (rest xs)))
  (assert-eq "general sequence structural equality" true (= xs [1 2]))
  (assert-eq "general sequence bounded display" "(1 2)" (str xs)))

(let [rendered (str (range))]
  (assert-eq "lazy range display starts with a prefix" true
             (starts-with? rendered "(0 1 2"))
  (assert-eq "lazy range display is bounded" true
             (includes? rendered "...")))

;; Clojure-compatible unbounded arities share the native sequence-step path;
;; the original finite arities remain covered by the long-tail suite.
(assert-eq "repeat one-arity is lazy" [7 7 7 7]
           (take 4 (repeat 7)))
(assert-eq "repeatedly one-arity is lazy" [5 5 5]
           (take 3 (repeatedly (fn [] 5))))
(assert-eq "iterate two-arity is lazy" [1 2 4 8 16]
           (take 5 (iterate (fn [x] (* x 2)) 1)))
(assert-eq "cycle one-arity is lazy" [1 2 1 2 1]
           (take 5 (cycle [1 2])))
(assert-eq "cycle empty input terminates" []
           (take 3 (cycle [])))

(let [calls (atom 0)
      xs (map (fn [x] (do (swap! calls inc) (* x 2))) [1 2 3])]
  (assert-eq "map is deferred" 0 @calls)
  (assert-eq "map realizes one item" 2 (first xs))
  (assert-eq "map realizes one item only" 1 @calls)
  (assert-eq "map consumes an infinite source by prefix" [0 2 4 6]
             (take 4 (map (fn [x] (* x 2)) (range)))))

(assert-eq "filter consumes an infinite source by prefix" [1 3 5 7]
           (take 4 (filter odd? (range))))

(let [calls (atom 0)
      xs (keep (fn [x] (do (swap! calls inc) (if (odd? x) x nil))) [1 2 3])]
  (assert-eq "keep is deferred" 0 @calls)
  (assert-eq "keep realizes through its first retained value" 1 (first xs))
  (assert-eq "keep does not precompute its tail" 1 @calls)
  (assert-eq "keep advances only to the next retained value" 3 (first (rest xs)))
  (assert-eq "keep skips values incrementally" 3 @calls))
(assert-eq "keep consumes an infinite source by prefix" [1 3 5 7]
           (take 4 (keep (fn [x] (if (odd? x) x nil)) (range))))
(assert-eq "keep retains false" [false]
           (keep (fn [x] (if (= x 1) false nil)) [0 1 2]))

(let [calls (atom 0)
      xs (keep-indexed (fn [i x]
                         (do (swap! calls inc)
                             (if (even? i) x nil)))
                       [10 20 30])]
  (assert-eq "keep-indexed is deferred" 0 @calls)
  (assert-eq "keep-indexed realizes its first retained value" 10 (first xs))
  (assert-eq "keep-indexed does not precompute its tail" 1 @calls)
  (assert-eq "keep-indexed advances indexes incrementally" 30 (first (rest xs)))
  (assert-eq "keep-indexed skips values incrementally" 3 @calls))
(assert-eq "keep-indexed consumes an infinite source by prefix" [0 2 4 6]
           (take 4 (keep-indexed (fn [i x] (if (even? i) x nil)) (range))))

(let [calls (atom 0)
      xs (map-indexed (fn [i x] (do (swap! calls inc) (+ i x))) [10 20 30])]
  (assert-eq "map-indexed is deferred" 0 @calls)
  (assert-eq "map-indexed realizes its first item" 10 (first xs))
  (assert-eq "map-indexed does not precompute its tail" 1 @calls)
  (assert-eq "map-indexed advances incrementally" 21 (first (rest xs)))
  (assert-eq "map-indexed realizes only reached items" 2 @calls))
(assert-eq "map-indexed consumes an infinite source by prefix" [0 2 4 6]
           (take 4 (map-indexed (fn [i x] (+ i x)) (range))))

(let [calls (atom 0)
      xs (mapcat (fn [x] (do (swap! calls inc) [x x])) [1 2 3])]
  (assert-eq "mapcat is deferred" 0 @calls)
  (assert-eq "mapcat realizes its first mapped collection" 1 (first xs))
  (assert-eq "mapcat does not invoke the next mapping early" 1 @calls)
  (assert-eq "mapcat emits the current mapped tail first" 1 (first (rest xs)))
  (assert-eq "mapcat preserves the current mapped collection" 1 @calls)
  (assert-eq "mapcat advances the outer source incrementally" 2 (first (rest (rest xs))))
  (assert-eq "mapcat invokes only reached mappings" 2 @calls))
(assert-eq "mapcat skips empty mapped collections lazily" [0 2 4]
           (take 3 (mapcat (fn [x] (if (even? x) [x] [])) (range))))
(assert-eq "mapcat consumes an infinite source by prefix" [0 0 1 1 2]
           (take 5 (mapcat (fn [x] [x x]) (range))))

(let [calls (atom 0)
      xs (butlast (map (fn [x] (do (swap! calls inc) x)) [1 2 3]))]
  (assert-eq "butlast is deferred" 0 @calls)
  (assert-eq "butlast emits the first item with one-item lookahead" 1 (first xs))
  (assert-eq "butlast realizes only the required lookahead" 2 @calls)
  (assert-eq "butlast advances its lookahead incrementally" 2 (first (rest xs)))
  (assert-eq "butlast reaches only the needed final lookahead" 3 @calls))
(assert-eq "butlast is productive on an infinite source" [0 1 2 3]
           (take 4 (butlast (range))))

(let [calls (atom 0)
      xs (take 2 (map (fn [x] (do (swap! calls inc) x)) [1 2 3]))]
  (assert-eq "take is deferred" 0 @calls)
  (assert-eq "take realizes one source item" 1 (first xs))
  (assert-eq "take realizes only its requested prefix" 1 @calls))

(assert-eq "take bounds an infinite source" [0 1 2 3]
           (take 4 (range)))
(assert-eq "drop consumes an infinite source by prefix" [5 6 7]
           (take 3 (drop 5 (range))))

(let [calls (atom 0)
      xs (concat [1] (map (fn [x] (do (swap! calls inc) x)) [2 3]))]
  (assert-eq "concat is deferred" 0 @calls)
  (assert-eq "concat realizes its eager prefix" 1 (first xs))
  (assert-eq "concat preserves a deferred later input" 0 @calls)
  (assert-eq "concat reaches the next input incrementally" 2 (first (rest xs)))
  (assert-eq "concat realizes only the reached item" 1 @calls))
(assert-eq "concat consumes an infinite source by prefix" [0 1 2 10 11]
           (take 5 (concat (range 3) (range 10))))

(let [calls (atom 0)
      xs (dedupe (map (fn [x] (do (swap! calls inc) x)) [1 1 2 2 3]))]
  (assert-eq "dedupe is deferred" 0 @calls)
  (assert-eq "dedupe realizes its first item" 1 (first xs))
  (assert-eq "dedupe realizes one source item" 1 @calls)
  (assert-eq "dedupe skips adjacent duplicates lazily" 2 (first (rest xs)))
  (assert-eq "dedupe realizes through the next distinct item" 3 @calls))
(assert-eq "dedupe consumes an infinite source by prefix" [0 1 2 3]
           (take 4 (dedupe (map (fn [x] (quot x 2)) (range)))))

(let [calls (atom 0)
      xs (distinct (map (fn [x] (do (swap! calls inc) (quot x 2))) (range)))]
  (assert-eq "distinct is deferred" 0 @calls)
  (assert-eq "distinct realizes its first item" 0 (first xs))
  (assert-eq "distinct realizes one source item" 1 @calls)
  (assert-eq "distinct skips duplicates incrementally" 1 (first (rest xs)))
  (assert-eq "distinct realizes only the prefix needed for next distinct item" 3 @calls))
(assert-eq "distinct consumes an infinite source by prefix" [0 1 2 3]
           (take 4 (distinct (map (fn [x] (quot x 2)) (range)))))

(let [left-calls (atom 0)
      right-calls (atom 0)
      xs (interleave (map (fn [x] (do (swap! left-calls inc) x)) [1 2])
                     (map (fn [x] (do (swap! right-calls inc) x)) [10 20]))]
  (assert-eq "interleave is deferred" [0 0] [@left-calls @right-calls])
  (assert-eq "interleave realizes its first round" 1 (first xs))
  (assert-eq "interleave forces one item per input for a round" [1 1]
             [@left-calls @right-calls])
  (assert-eq "interleave emits the prepared second head" 10 (first (rest xs)))
  (assert-eq "interleave does not begin the next round early" [1 1]
             [@left-calls @right-calls]))
(assert-eq "interleave consumes infinite sources by prefix" [0 10 1 11 2 12]
           (take 6 (interleave (range) (range 10))))

(let [calls (atom 0)
      xs (interpose :sep (map (fn [x] (do (swap! calls inc) x)) [1 2 3]))]
  (assert-eq "interpose is deferred" 0 @calls)
  (assert-eq "interpose realizes its first item" 1 (first xs))
  (assert-eq "interpose realizes one source item" 1 @calls)
  (assert-eq "interpose emits its separator without advancing input" :sep
             (first (rest xs)))
  (assert-eq "interpose still has one realized source item" 1 @calls)
  (assert-eq "interpose advances at the next source item" 2
             (first (rest (rest xs))))
  (assert-eq "interpose realizes the next source item once" 2 @calls))
(assert-eq "interpose consumes infinite sources by prefix" [0 :x 1 :x 2]
           (take 5 (interpose :x (range))))

(let [calls (atom 0)
      xs (partition-all 2 (map (fn [x] (do (swap! calls inc) x)) [1 2 3 4]))]
  (assert-eq "partition-all is deferred" 0 @calls)
  (assert-eq "partition-all realizes one bounded chunk" [1 2] (first xs))
  (assert-eq "partition-all realizes only its chunk" 2 @calls))
(assert-eq "partition-all consumes an infinite source by prefix" [[0 1] [2 3] [4 5]]
           (take 3 (partition-all 2 (range))))
(assert-eq "partition consumes an infinite source by prefix" [[0 1] [2 3] [4 5]]
           (take 3 (partition 2 (range))))
(assert-eq "partition-by consumes an infinite source by prefix" [[0 1] [2 3] [4 5]]
           (take 3 (partition-by (fn [x] (quot x 2)) (range))))
(assert-eq "take-while bounds an infinite source" [0 1 2 3]
           (take-while (fn [x] (< x 4)) (range)))
(assert-eq "drop-while consumes an infinite source by prefix" [4 5 6]
           (take 3 (drop-while (fn [x] (< x 4)) (range))))

;; Consumers must traverse the same sequence protocol. In particular, `into`
;; is implemented in terms of `reduce`; it cannot rely on a collection's eager
;; count when its input is a lazy transform.
(assert-eq "reduce consumes a lazy map" 20
           (reduce + 0 (take 4 (map (fn [x] (* x 2)) (range)))))
(assert-eq "into consumes a lazy map" [2 3 4]
           (into [] (map inc [1 2 3])))
(assert-eq "into composes lazy map and filter" [1 9]
           (into [] (filter odd? (map (fn [x] (* x x)) [1 2 3 4]))))
(assert-eq "join consumes a lazy map" "2,4,6"
           (join "," (map (fn [x] (* x 2)) [1 2 3])))
(assert-eq "reduce propagates lazy forcing errors" true
           (try
             (do
               (reduce + 0 (lazy-seq 42))
               false)
             (catch e (string? e))))
(assert-eq "reduce propagates reducing function errors" true
           (try
             (do
               (reduce (fn [acc x] (throw "reduce boom")) 0 [1])
               false)
             (catch e (string? e))))

(println "native lazy-seq passed")
