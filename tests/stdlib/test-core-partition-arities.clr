(ns tests.stdlib.test-core-partition-arities)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn throws? [f]
  (try
    (do
      (f)
      false)
    (catch e true)))

(defn -main [& _args]
  (do
    (assert-eq "partition supports overlapping chunks"
               (partition 3 1 [1 2 3 4])
               '([1 2 3] [2 3 4]))
    (assert-eq "partition supports gapped chunks"
               (partition 2 3 [1 2 3 4 5 6])
               '([1 2] [4 5]))
    (assert-eq "partition pads only the final chunk"
               (partition 3 2 [0] [1 2 3 4])
               '([1 2 3] [3 4 0]))
    (assert-eq "partition accepts nil padding"
               (partition 3 2 nil [1 2 3 4])
               '([1 2 3] [3 4]))
    (assert-eq "partition-all supports overlapping chunks"
               (partition-all 3 1 [1 2 3 4])
               '([1 2 3] [2 3 4] [3 4] [4]))
    (assert-eq "partition-all supports gapped chunks"
               (partition-all 2 3 [1 2 3 4 5 6])
               '([1 2] [4 5]))
    (assert-eq "stepped partition is productive on an infinite source"
               (take 3 (partition 2 3 (range)))
               '([0 1] [3 4] [6 7]))
    (assert-eq "partition rejects non-positive step"
               (throws? (fn [] (partition 2 0 [1 2])))
               true)
    (assert-eq "partition-all rejects non-positive step"
               (throws? (fn [] (partition-all 2 0 [1 2])))
               true)
    "PASS"))
