(ns tests.stdlib.test-core-merge)

;; Regression test: merge was hardcoded to exactly 1 argument (a vector of
;; maps), so idiomatic (merge m1 m2) failed with "merge requires 1
;; argument" -- the only way to call it was (merge [m1 m2]). Fixed to
;; accept the real, variadic clojure.core/merge signature.

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "merge two maps" (str (merge {:a 1} {:b 2})) "{:a 1 :b 2}")
    (assert-eq "merge, later key wins" (str (merge {:a 1} {:a 2 :b 3})) "{:a 2 :b 3}")
    (assert-eq "merge three maps" (str (merge {:a 1} {:b 2} {:c 3 :a 9})) "{:a 9 :b 2 :c 3}")
    (assert-eq "merge single map" (str (merge {:a 1})) "{:a 1}")
    "PASS"))
