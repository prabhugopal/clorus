(ns tests.stdlib.test-core-update-arity)

(defn assert-eq [label actual expected]
  (if (= actual expected)
    true
    (throw (str "assert failed [" label "] expected=" expected " actual=" actual))))

(defn -main [& _args]
  (do
    (assert-eq "update 3-arity"
               (update {:n 1} :n inc)
               {:n 2})
    (assert-eq "update 4-arity"
               (update {:n 1} :n + 10)
               {:n 11})
    (assert-eq "update 5-arity"
               (update {:n 1} :n (fn [v a b] (+ (+ v a) b)) 10 20)
               {:n 31})
    (assert-eq "update 6-arity"
               (update {:n 1} :n (fn [v a b c] (+ (+ (+ v a) b) c)) 10 20 30)
               {:n 61})
    (assert-eq "update variadic 7-arity via apply path"
               (update {:n 1} :n (fn [v a b c d] (+ (+ (+ (+ v a) b) c) d)) 10 20 30 40)
               {:n 101})
    (assert-eq "update missing key passes nil"
               (update {} :n (fn [v] (if v v 0)))
               {:n 0})
    "PASS"))
