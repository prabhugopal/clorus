;; Integration test for dynamic binding semantics.
;; This file must remain a single, deterministic test entry.

(def *x* 10)

(defn -main [& _args]
  (let [initial *x*
        inside (binding [*x* 20]
                 *x*)
        after *x*]
    (if (and (= initial 10)
             (= inside 20)
             (= after 10))
      (do
        (println "binding integration test: PASS")
        "PASS")
      (throw (str "binding integration test: FAIL initial=" initial
                  " inside=" inside
                  " after=" after)))))
