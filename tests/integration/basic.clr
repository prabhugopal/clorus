;; Basic integration smoke test.
;; Keep this test fast and deterministic across JIT and legacy engines.

(defn -main [& _args]
  (let [sum (+ 2 3)
        vec1 [1 2]
        vec2 (conj vec1 3)
        m {:a 1 :b 2}
        ok (and (= sum 5)
                (= (count vec2) 3)
                (= (nth vec2 2) 3)
                (= (:a m) 1))]
    (if ok
      (do
        (println "basic integration test: PASS")
        "PASS")
      (throw "basic integration test: FAIL"))))
