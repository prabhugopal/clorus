;; Test multi-arity fn support
(defn test-fn
  ([x] (* x 10))
  ([x y] (+ x y)))

;; Test 1-arity
(test-fn 5)
;; Test multi-arity fn support
(defn test-fn
  ([x] (* x 10))
  ([x y] (+ x y)))

;; Test 2-arity
(test-fn 5 3)
;; Test multi-arity anonymous fn with dispatcher

(def test-fn
  (fn
    ([x] (* x 10))
    ([x y] (+ x y))))

;; Test 1-arity
(test-fn 5)
;; Test 2-arity call
(def test-fn
  (fn
    ([x] (* x 10))
    ([x y] (+ x y))))

;; Test 2-arity
(test-fn 5 3)
