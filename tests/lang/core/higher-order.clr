;; Test if higher-order functions work with fn (anonymous functions)

;; Define take-while inline
(defn take-while-test [pred coll]
  (if (= (count coll) 0)
    []
    (let [x (first coll)]
      (if (pred x)
        (conj (take-while-test pred (rest coll)) x)
        []))))

;; Use an anonymous function instead of defn
(def result (take-while-test (fn [x] (< x 5)) [1 2 3 6 7 1]))
;; Expected: [1 2 3]

result
;; Test closures with existing HOFs
;; 1. Test map with a closure
(defn make-adder [n]
  (fn [x] (+ x n)))

(def add-10 (make-adder 10))
(def result1 (map add-10 [1 2 3]))

;; 2. Test filter with a closure
(defn make-threshold-filter [threshold]
  (fn [x] (> x threshold)))

(def over-5 (make-threshold-filter 5))
(def result2 (filter over-5 [3 5 7 9]))

;; 3. Test reduce with a closure
(defn make-accumulator [initial]
  (fn [acc x] (+ acc x initial)))

(def add-with-bonus (make-accumulator 1))
(def result3 (reduce add-with-bonus 0 [1 2 3]))

result1
;; Define our own simple map to test (non-recursive for simplicity)
(defn my-map-twice [f coll]
  ;; Just apply f to first two elements for testing
  [(f (first coll)) (f (first (rest coll)))])

;; Create a closure
(defn make-adder [n]
  (fn [x] (+ x n)))

(def add-10 (make-adder 10))

;; Test with our custom map
(def result (my-map-twice add-10 [1 2 3]))

result
;; Test basic function parameter passing

(defn apply-fn [f x]
  (f x))

(apply-fn (fn [x] (+ x 10)) 5)
