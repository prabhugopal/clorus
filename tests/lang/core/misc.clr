(def result (and true false))
(println result)
;; Test mod operation
(defn even? [n]
  (= (mod n 2) 0))

;; Test even?
(if (even? 4)
  100
  200)
;; Test mod operation with odd number
(defn even? [n]
  (= (mod n 2) 0))

;; Test with odd number
(if (even? 5)
  100
  200)
