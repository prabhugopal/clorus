(pr-str 42)
;; Test anonymous function with parameter returning closure
(def make-adder
  (fn [x]
    (fn [y] (+ x y))))

(def add-5 (make-adder 5))
"created"
;; Test simple single-arity anonymous fn first
(def simple-fn
  (fn [x] (* x 2)))

(simple-fn 5)
