; Test defn return value
(ns test-defn-return)

(defn hello [] "Hello!")

(defn greet
  "Multi-arity greeting"
  ([] "Hi!")
  ([name] name))

(defn -main []
  (do
    (println "Defined hello:")
    (println (hello))
    (println "\nDefined greet:")
    (println (greet))
    (println (greet "Alice"))))
