(def m {:name "test" :fn (fn [] 42)})
(println m)
;; Load stdlib
(load "stdlib/core.clr")

;; Test map with a closure from a factory function
(defn make-adder [n]
  (fn [x] (+ x n)))

(def add-10 (make-adder 10))

;; This should work now
(def result (map add-10 [1 2 3]))

result
(println "Testing conj:")
(def v1 [1 2 3])
(def v2 (conj v1 4))
(println v2)
(println "Expected: [1 2 3 4]")
;; Test single conj
(count (conj [] 1))
;; Test if vector is computed but not printed
(defn make-vector []
  [1 2 3])

(count (make-vector))
;; Test 3: Just return a vector
(defn make-vector []
  [1 2 3])

(make-vector)
