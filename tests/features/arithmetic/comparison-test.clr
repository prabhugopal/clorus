;; Comprehensive test for comparison operators
;; Tests: <, >, <=, >=, =

;; Test less-than (<)
(defn test-less-than []
  (do
    (if (< 1 2) nil (throw "< 1 2 should be true"))
    (if (< 2 1) (throw "< 2 1 should be false") nil)
    (if (< 5 10) nil (throw "< 5 10 should be true"))
    (if (< -5 0) nil (throw "< -5 0 should be true"))
    (if (< 0 -5) (throw "< 0 -5 should be false") nil)))

;; Test greater-than (>)
(defn test-greater-than []
  (do
    (if (> 2 1) nil (throw "> 2 1 should be true"))
    (if (> 1 2) (throw "> 1 2 should be false") nil)
    (if (> 10 5) nil (throw "> 10 5 should be true"))
    (if (> 0 -5) nil (throw "> 0 -5 should be true"))
    (if (> -5 0) (throw "> -5 0 should be false") nil)))

;; Test equality (=)
(defn test-equality []
  (do
    (if (= 1 1) nil (throw "= 1 1 should be true"))
    (if (= 1 2) (throw "= 1 2 should be false") nil)
    (if (= 0 0) nil (throw "= 0 0 should be true"))
    (if (= -5 -5) nil (throw "= -5 -5 should be true"))
    (if (= 10 10) nil (throw "= 10 10 should be true"))))

;; Test less-than-or-equal (<=)
;; NOTE: This is currently BROKEN - <= always returns true (1)
(defn test-less-than-or-equal []
  (do
    (if (<= 1 2) nil (throw "<= 1 2 should be true"))
    (if (<= 1 1) nil (throw "<= 1 1 should be true"))
    (if (<= 2 1) (throw "<= 2 1 should be false") nil)  ; FAILS - always true
    (if (<= 5 5) nil (throw "<= 5 5 should be true"))
    (if (<= 0 0) nil (throw "<= 0 0 should be true"))
    (if (<= 10 5) (throw "<= 10 5 should be false") nil))) ; FAILS - always true

;; Test greater-than-or-equal (>=)
;; NOTE: This is currently BROKEN - >= always returns true (1)
(defn test-greater-than-or-equal []
  (do
    (if (>= 2 1) nil (throw ">= 2 1 should be true"))
    (if (>= 1 1) nil (throw ">= 1 1 should be true"))
    (if (>= 1 2) (throw ">= 1 2 should be false") nil)  ; FAILS - always true
    (if (>= 5 5) nil (throw ">= 5 5 should be true"))
    (if (>= 0 0) nil (throw ">= 0 0 should be true"))
    (if (>= 5 10) (throw ">= 5 10 should be false") nil))) ; FAILS - always true

;; Run all tests
(defn -main []
  (do
    (println "Testing < operator...")
    (test-less-than)
    (println "✓ < tests passed")

    (println "Testing > operator...")
    (test-greater-than)
    (println "✓ > tests passed")

    (println "Testing = operator...")
    (test-equality)
    (println "✓ = tests passed")

    (println "Testing <= operator...")
    (test-less-than-or-equal)
    (println "✓ <= tests passed")

    (println "Testing >= operator...")
    (test-greater-than-or-equal)
    (println "✓ >= tests passed")

    (println "All comparison operator tests passed!")))
