;; Simple test for <= and >= bug

(defn -main []
  (do
    (println "Testing (<= 2 1):" (<= 2 1))
    (println "Testing (>= 1 2):" (>= 1 2))
    (println "Testing (<= 1 2):" (<= 1 2))
    (println "Testing (>= 2 1):" (>= 2 1))

    ;; These should fail if the bug exists
    (if (<= 2 1)
      (println "ERROR: (<= 2 1) returned true, should be false!")
      (println "OK: (<= 2 1) correctly returned false"))

    (if (>= 1 2)
      (println "ERROR: (>= 1 2) returned true, should be false!")
      (println "OK: (>= 1 2) correctly returned false"))))
