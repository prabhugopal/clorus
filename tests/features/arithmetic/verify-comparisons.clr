;; Verify comparison operators work correctly
;; This test will throw if operators are broken

(defn -main []
  (do
    (println "Testing comparison operators...")

    ;; Test < (should work)
    (if (< 1 2)
      nil
      (throw "< is broken"))
    (println "✓ < works")

    ;; Test > (should work)
    (if (> 2 1)
      nil
      (throw "> is broken"))
    (println "✓ > works")

    ;; Test = (should work)
    (if (= 5 5)
      nil
      (throw "= is broken"))
    (println "✓ = works")

    ;; Test <= (might be broken)
    (if (<= 1 2)
      nil
      (throw "<= 1 2 should be true but returned false"))
    (println "✓ <= works for 1 <= 2")

    (if (<= 5 5)
      nil
      (throw "<= 5 5 should be true but returned false"))
    (println "✓ <= works for 5 <= 5")

    (if (<= 2 1)
      (throw "<= 2 1 should be false but returned true")
      nil)
    (println "✓ <= works for 2 <= 1 (should be false)")

    ;; Test >= (might be broken)
    (if (>= 2 1)
      nil
      (throw ">= 2 1 should be true but returned false"))
    (println "✓ >= works for 2 >= 1")

    (if (>= 5 5)
      nil
      (throw ">= 5 5 should be true but returned false"))
    (println "✓ >= works for 5 >= 5")

    (if (>= 1 2)
      (throw ">= 1 2 should be false but returned true")
      nil)
    (println "✓ >= works for 1 >= 2 (should be false)")

    (println "")
    (println "✅ ALL COMPARISON OPERATORS WORKING CORRECTLY!")))
