;; Test set literals

(defn -main []
  (do
    (println "Testing set literals...")

    (let [s1 #{1 2 3}]
      (do
        (println "s1 =" s1)
        (if (contains? s1 2)
          (println "✓ contains? works for s1")
          (throw "contains? failed for s1"))))

    (let [s2 #{:a :b :c}]
      (do
        (println "s2 =" s2)
        (if (contains? s2 :b)
          (println "✓ contains? works for s2")
          (throw "contains? failed for s2"))))

    (let [s3 #{}]
      (do
        (println "empty set =" s3)
        (if (= (count s3) 0)
          (println "✓ empty set count is 0")
          (throw "empty set count failed"))))

    (let [s4 #{1 2 3}
          s5 (conj s4 4)]
      (do
        (println "s4 =" s4)
        (println "s5 =" s5)
        (if (contains? s5 4)
          (println "✓ conj adds element to set")
          (throw "conj failed"))))

    (println "")
    (println "✅ ALL SET LITERAL TESTS PASSED!")))
