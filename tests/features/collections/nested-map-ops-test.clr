;; Test for nested map operations: get-in, assoc-in, update-in
;; These are P1 high-priority features for working with nested data structures

(defn test-get-in []
  ;; get-in should retrieve values from nested maps
  (let [data {:a {:b {:c 42}}}]
    (do
      ;; Test basic nested access
      (if (= (get-in data [:a :b :c]) 42)
        nil
        (throw "get-in should retrieve nested value 42"))

      ;; Test partial path
      (if (= (get-in data [:a :b]) {:c 42})
        nil
        (throw "get-in should retrieve nested map {:c 42}"))

      ;; Test non-existent path should return nil
      (if (= (get-in data [:x :y :z]) nil)
        nil
        (throw "get-in should return nil for non-existent path"))

      ;; Test with default value
      (if (= (get-in data [:x :y] "default") "default")
        nil
        (throw "get-in should return default value for non-existent path")))))

(defn test-assoc-in []
  ;; assoc-in should set values in nested maps
  (let [data {:a {:b {:c 1}}}
        result (assoc-in data [:a :b :c] 42)]
    (do
      ;; Test that value was updated
      (if (= (get-in result [:a :b :c]) 42)
        nil
        (throw "assoc-in should set nested value to 42"))

      ;; Test original is unchanged (immutability)
      (if (= (get-in data [:a :b :c]) 1)
        nil
        (throw "assoc-in should not modify original map"))

      ;; Test creating new nested path
      (let [result2 (assoc-in {} [:x :y :z] "new")]
        (if (= (get-in result2 [:x :y :z]) "new")
          nil
          (throw "assoc-in should create new nested path"))))))

(defn test-update-in []
  ;; update-in should update values in nested maps using a function
  (let [data {:a {:b {:c 10}}}
        result (update-in data [:a :b :c] inc)]
    (do
      ;; Test that value was updated by function
      (if (= (get-in result [:a :b :c]) 11)
        nil
        (throw "update-in should apply inc to value"))

      ;; Test original is unchanged (immutability)
      (if (= (get-in data [:a :b :c]) 10)
        nil
        (throw "update-in should not modify original map"))

      ;; Test with function that takes multiple args
      (let [result2 (update-in data [:a :b :c] + 5)]
        (if (= (get-in result2 [:a :b :c]) 15)
          nil
          (throw "update-in should apply + with extra args"))))))

(defn test-update []
  ;; update should update a top-level value using a function
  (let [data {:count 5}
        result (update data :count inc)]
    (do
      ;; Test that value was updated
      (if (= (:count result) 6)
        nil
        (throw "update should apply inc to :count"))

      ;; Test original is unchanged
      (if (= (:count data) 5)
        nil
        (throw "update should not modify original map")))))

(defn -main []
  (do
    (println "Testing get-in...")
    (test-get-in)
    (println "✓ get-in tests passed")

    (println "Testing assoc-in...")
    (test-assoc-in)
    (println "✓ assoc-in tests passed")

    (println "Testing update-in...")
    (test-update-in)
    (println "✓ update-in tests passed")

    (println "Testing update...")
    (test-update)
    (println "✓ update tests passed")

    (println "All nested map operation tests passed!")))
