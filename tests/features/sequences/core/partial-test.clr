;; First 100 lines of stdlib/core.clr to test
(defn partial [f & args]
  (fn [& more-args]
    (apply f (concat args more-args))))

(defn comp [& fns]
  (if (empty? fns)
    identity
    (fn [x]
      (reduce (fn [acc f] (f acc))
              x
              (reverse fns)))))

(defn identity [x] x)

(defn constantly [x]
  (fn [& _args] x))

(defn complement [f]
  (fn [& args]
    (not (apply f args))))

(defn juxt [& fns]
  (fn [& args]
    (map (fn [f] (apply f args)) fns)))

;; Predicates
(defn nil? [x]
  (= x nil))

(defn some? [x]
  (not (nil? x)))

(defn zero? [x]
  (= x 0))

(defn pos? [x]
  (> x 0))

(defn neg? [x]
  (< x 0))

(defn even? [x]
  (= (mod x 2) 0))

(defn odd? [x]
  (not (even? x)))

(defn empty? [coll]
  (= (count coll) 0))

(defn not-empty [coll]
  (if (empty? coll)
    nil
    coll))
