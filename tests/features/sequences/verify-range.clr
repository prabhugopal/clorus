;; Test range function

(defn -main []
  (do
    (println "Testing range function...")

    (let [r1 (range 5)]
      (do
        (println "range 5 =" r1)
        (if (= r1 [0 1 2 3 4])
          (println "✓ range 5 works")
          (throw "range 5 failed"))))

    (let [r2 (range 2 7)]
      (do
        (println "range 2 7 =" r2)
        (if (= r2 [2 3 4 5 6])
          (println "✓ range 2 7 works")
          (throw "range 2 7 failed"))))

    (let [r3 (range 0 10 2)]
      (do
        (println "range 0 10 2 =" r3)
        (if (= r3 [0 2 4 6 8])
          (println "✓ range 0 10 2 works")
          (throw "range 0 10 2 failed"))))

    (println "")
    (println "✅ ALL RANGE TESTS PASSED!")))
