;; Simple ref test
(println "Creating ref with value 42...")
(def r (ref 42))
(println "Ref created")
(println "Dereferencing ref...")
(def val @r)
(println "Value:")
(println val)
(println "Done")
;; Debug ref creation
(println "Creating ref...")
(def r (ref 42))
(println "Ref created")
(println "Trying deref...")
(def val @r)
(println (str "Deref result: [" val "]"))
(println "Printing val directly:")
(println val)
(println "Done")
;; Simplest possible dosync + alter test
(defn inc-fn [x] (+ x 1))

(def r (ref 10))
(println "Before:")
(println @r)

(dosync (alter r inc-fn))

(println "After:")
(println @r)
;; Test alter with closure - more debug
(println "Step 1: Create ref")
(def r (ref 10))
(println "Step 2: Check initial value")
(println @r)

(println "Step 3: Create closure")
(let [add-5 (fn [x] (+ x 5))]
  (println "Step 4: Closure created")
  (println "Step 5: Starting dosync")
  (dosync
    (println "Step 6: Inside dosync")
    (alter r add-5)
    (println "Step 7: After alter"))
  (println "Step 8: After dosync")
  (println @r)
  (println "Expected: 15"))

(println "Done")
;; Test alter with closure - check result only
(def r (ref 100))

;; Test 1: Alter with inline fn
(dosync (alter r (fn [x] (+ x 1))))

(def result1 @r)
(def expected1 101)
(def test1-pass (= result1 expected1))

(if test1-pass
  (println "✓ Test 1 PASS: alter with inline fn")
  (println "✗ Test 1 FAIL"))

;; Test 2: Reset and try with let-bound closure
(dosync (alter r (fn [x] (- x 1))))  ;; Back to 100

(let [multiplier (fn [x] (* x 2))]
  (dosync (alter r multiplier)))

(def result2 @r)
(def expected2 200)
(def test2-pass (= result2 expected2))

(if test2-pass
  (println "✓ Test 2 PASS: alter with let-bound closure")
  (println "✗ Test 2 FAIL"))

"Tests complete"
