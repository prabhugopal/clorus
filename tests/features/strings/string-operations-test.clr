;; String Operations Test Suite
;; Tests comprehensive string manipulation functions

(println "=== String Operations Tests ===\n")

;; Test 1: String concatenation
(println "--- Test 1: String Concatenation ---")
(def result1 (str "hello" " " "world"))
(println "str concat:" result1)
;; Expected: "hello world"

(def result2 (str "count: " 42))
(println "str with number:" result2)
;; Expected: "count: 42"

(def result3 (str))
(println "str empty:" result3)
;; Expected: ""

;; Test 2: Substring extraction
(println "\n--- Test 2: Substring ---")
(def result4 (subs "hello world" 0 5))
(println "subs [0,5):" result4)
;; Expected: "hello"

(def result5 (subs "hello world" 6))
(println "subs from 6:" result5)
;; Expected: "world"

(def result6 (subs "hello" 1 4))
(println "subs [1,4):" result6)
;; Expected: "ell"

;; Test 3: Split
(println "\n--- Test 3: Split ---")
(def result7 (split "a,b,c" ","))
(println "split by comma:" result7)
;; Expected: ["a" "b" "c"]

(def result8 (split "hello world" " "))
(println "split by space:" result8)
;; Expected: ["hello" "world"]

;; Test 4: Join
(println "\n--- Test 4: Join ---")
(def result9 (join "," ["a" "b" "c"]))
(println "join with comma:" result9)
;; Expected: "a,b,c"

(def result10 (join " " ["hello" "world"]))
(println "join with space:" result10)
;; Expected: "hello world"

(def result11 (join ", " [1 2 3]))
(println "join numbers:" result11)
;; Expected: "1, 2, 3"

;; Test 5: Case conversion
(println "\n--- Test 5: Case Conversion ---")
(def result12 (upper-case "hello"))
(println "uppercase:" result12)
;; Expected: "HELLO"

(def result13 (lower-case "WORLD"))
(println "lowercase:" result13)
;; Expected: "world"

(def result14 (upper-case "Hello World"))
(println "uppercase mixed:" result14)
;; Expected: "HELLO WORLD"

;; Test 6: Trim
(println "\n--- Test 6: Trim ---")
(def result15 (trim "  hello  "))
(println "trim:" result15)
;; Expected: "hello"

(def result16 (trim-left "  hello  "))
(println "trim-left:" result16)
;; Expected: "hello  "

(def result17 (trim-right "  hello  "))
(println "trim-right:" result17)
;; Expected: "  hello"

;; Test 7: Replace
(println "\n--- Test 7: Replace ---")
(def result18 (replace "hello" "l" "L"))
(println "replace all:" result18)
;; Expected: "heLLo"

(def result19 (replace-first "hello hello" "ll" "yy"))
(println "replace first:" result19)
;; Expected: "heyyo hello"

(def result20 (replace "hello world" "o" "0"))
(println "replace o with 0:" result20)
;; Expected: "hell0 w0rld"

;; Test 8: String predicates
(println "\n--- Test 8: String Predicates ---")
(def result21 (string? "hello"))
(println "string? on string:" result21)
;; Expected: true (1.0)

(def result22 (string? 42))
(println "string? on number:" result22)
;; Expected: false (0.0)

(def result23 (starts-with? "hello world" "hello"))
(println "starts-with? true:" result23)
;; Expected: true (1.0)

(def result24 (starts-with? "hello" "world"))
(println "starts-with? false:" result24)
;; Expected: false (0.0)

(def result25 (ends-with? "hello.txt" ".txt"))
(println "ends-with? true:" result25)
;; Expected: true (1.0)

(def result26 (ends-with? "hello" ".txt"))
(println "ends-with? false:" result26)
;; Expected: false (0.0)

(def result27 (includes? "hello world" "lo wo"))
(println "includes? true:" result27)
;; Expected: true (1.0)

(def result28 (includes? "hello" "xyz"))
(println "includes? false:" result28)
;; Expected: false (0.0)

;; Test 9: Complex operations
(println "\n--- Test 9: Complex Operations ---")
(def result29 (str (upper-case "hello") " " (lower-case "WORLD")))
(println "combined case ops:" result29)
;; Expected: "HELLO world"

(def result30 (join " " (split "a,b,c" ",")))
(println "split then join:" result30)
;; Expected: "a b c"

(def result31 (trim (str "  " "hello" "  ")))
(println "str then trim:" result31)
;; Expected: "hello"

(println "\n✅ All string operations tested!")
