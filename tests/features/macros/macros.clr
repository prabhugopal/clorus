;; Simple test without gensyms
(defmacro test-macro [[binding coll]]
  `(loop [remaining ~coll]
     (when (not (empty? remaining))
       (let [~binding (first remaining)]
         (recur (rest remaining))))))
;; Test macroexpand and macroexpand-1 with built-in macros

;; Test 1: macroexpand with when
(def test1 (macroexpand '(when true (+ 1 2) (+ 3 4))))

;; Test 2: macroexpand-1 with when (single step)
(def test2 (macroexpand-1 '(when true (+ 1 2) (+ 3 4))))

;; Test 3: macroexpand with if-let
(def test3 (macroexpand '(if-let [x 42] x 0)))

;; Test 4: macroexpand with -> (thread-first)
(def test4 (macroexpand '(-> 5 inc dec)))

;; Test 5: macroexpand with and
(def test5 (macroexpand '(and true false true)))

;; Test 6: macroexpand with cond
(def test6 (macroexpand '(cond (< x 0) "neg" (= x 0) "zero" :else "pos")))

;; Return a simple value to indicate completion
42
