;; Test 1: Define a record type
(defrecord Person [name age email])

;; Test 2: Create instances using constructor
(def alice (->Person "Alice" 30 "alice@example.com"))
(def bob (->Person "Bob" 25 "bob@example.com"))

;; Test 3: Access fields using get
(def alice-name (get alice :name))
(def alice-age (get alice :age))
(def bob-email (get bob :email))

;; Test 4: Use in functions
(defn greet [person]
  (get person :name))

(def greeting (greet alice))

;; Test 5: Multiple record types
(defrecord Point [x y])
(def p1 (->Point 10 20))
(def p1-x (get p1 :x))

;; Return final result
(+ (get alice :age) (get bob :age))  ;; Should return 55
