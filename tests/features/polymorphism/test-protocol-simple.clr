;; Define a simple protocol
(defprotocol Drawable
  (draw [this] "Draw the object"))

;; Define a record type
(defrecord Point [x y])

;; Implement the protocol for Point
(extend-type Point
  Drawable
  (draw [this]
    (get this :x)))

;; Create an instance and call the protocol method
(do
  (def p (->Point 10 20))
  (Point_Drawable_draw p))
