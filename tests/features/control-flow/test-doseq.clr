;; Test doseq macro
;; (doseq [x coll] body...) => iterate over collection with side effects

;; Test 1: Simple doseq over vector
(println "Test 1: Simple doseq over vector")
(doseq [x [10 20 30 40]]
  (println "Value:" x))
;; Expected: prints 10, 20, 30, 40

;; Test 2: Doseq with accumulation
(println "\nTest 2: Doseq with accumulation")
(def total (atom 0))
(doseq [n [1 2 3 4 5]]
  (swap! total (fn [t] (+ t n))))
(println "Total:" @total)
;; Expected: 15

;; Test 3: Doseq over list
(println "\nTest 3: Doseq over list")
(def numbers '(5 10 15 20))
(def sum (atom 0))
(doseq [num numbers]
  (swap! sum (fn [s] (+ s num))))
(println "Sum of list:" @sum)
;; Expected: 50

;; Test 4: Doseq with multiple statements
(println "\nTest 4: Multiple statements in body")
(def result (atom []))
(doseq [x [1 2 3]]
  (println "Processing" x)
  (def doubled (* x 2))
  (println "Doubled:" doubled)
  (swap! result (fn [r] (conj r doubled))))
(println "Result:" @result)
;; Expected: [2 4 6]

;; Test 5: Doseq over empty collection
(println "\nTest 5: Empty collection")
(doseq [x []]
  (println "Should not print"))
(println "Done with empty")
;; Expected: just "Done with empty"
