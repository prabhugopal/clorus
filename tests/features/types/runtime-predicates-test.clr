;; Runtime-backed predicate sanity tests.
;; Focus: direct calls + higher-order usage of predicate function values.

(defn assert-true [label value]
  (if value
    (println "✓" label)
    (throw (str "assertion failed: " label))))

(defn assert-false [label value]
  (assert-true label (not value)))

(defn -main []
  (do
    (println "Running runtime predicate tests...")

    ;; Direct predicate checks
    (assert-true "nil? nil" (nil? nil))
    (assert-false "nil? 42" (nil? 42))

    (assert-true "string? \"clorus\"" (string? "clorus"))
    (assert-false "string? 42" (string? 42))

    (assert-true "number? 42" (number? 42))
    (assert-true "number? 3.14" (number? 3.14))
    (assert-false "number? \"42\"" (number? "42"))

    (assert-true "vector? [1 2]" (vector? [1 2]))
    (assert-false "vector? {:a 1}" (vector? {:a 1}))

    (assert-true "list? (list 1 2)" (list? (list 1 2)))
    (assert-false "list? [1 2]" (list? [1 2]))

    (assert-true "map? {:a 1}" (map? {:a 1}))
    (assert-false "map? [1 2]" (map? [1 2]))

    (assert-true "set? #{1 2}" (set? #{1 2}))
    (assert-false "set? [1 2]" (set? [1 2]))

    (assert-true "keyword? :k" (keyword? :k))
    (assert-false "keyword? \"k\"" (keyword? "k"))

    (assert-true "boolean? true" (boolean? true))
    (assert-true "boolean? false" (boolean? false))
    (assert-false "boolean? nil" (boolean? nil))

    ;; Higher-order checks: ensure predicate vars are callable function values.
    (let [xs ["a" 1 "b" 2]
          ys [1 "x" 2 "y"]
          string-mask (map string? xs)
          number-mask (map number? ys)]
      (assert-true "map string? first" (= (first string-mask) true))
      (assert-true "map string? second" (= (nth string-mask 1) false))
      (assert-true "map number? first" (= (first number-mask) true))
      (assert-true "map number? second" (= (nth number-mask 1) false)))

    (println "✅ runtime predicate tests passed")))

