;; Simple exception test - basic throw and try structure

;; Test that throw compiles
(defn will-throw []
  (throw 42))

;; Test that try/catch/finally compiles
(defn test-try-catch []
  (try
    (+ 1 2 3)
    (catch e
      0)
    (finally
      (+ 5 5))))

;; Call the try/catch (should return 6)
(test-try-catch)
