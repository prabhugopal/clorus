;; Simple closure that we know works
(def x 5)
(def add-x (fn [y] (+ x y)))
(add-x 3)
;; Test: function that takes a parameter and returns a closure that captures it
;; This is simpler than nested functions
(defn make-adder [x]
  (fn [y] (+ x y)))

(def add-5 (make-adder 5))
(add-5 3)
;; Test closure capturing a def'd variable
(def x 5)

(def make-adder
  (fn []
    (fn [y] (+ x y))))

(def add-x (make-adder))
(add-x 3)
;; Test nested closure that returns a closure
(def outer
  (fn [x]
    (fn [y] (+ x y))))

;; Get the inner closure
(def add-5 (outer 5))

;; Call it - should return 8
(add-5 3)
;; Closure that doesn't capture anything
(def make-func
  (fn [x]
    (fn [] 42)))

(def f (make-func 5))
"created"
;; Simplest possible capture - just return the parameter
(def make-const
  (fn [x]
    (fn [] x)))

(def get-5 (make-const 5))
;; Call the closure to get the captured value
(get-5)
