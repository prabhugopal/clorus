; Test multi-arity defn with docstrings
(ns test-multi-arity-docstring)

(defn greet
  "A friendly greeting function with multiple arities"
  ([] "Hello, World!")
  ([name] (str "Hello, " name "!")))

(defn add
  "Add numbers with variable arity"
  ([] 0)
  ([x] x)
  ([x y] (+ x y))
  ([x y z] (+ x y z)))

(defn -main []
  (do
    (println "Testing multi-arity defn with docstrings...")

    (println "\nTesting greet:")
    (println (greet))
    (println (greet "Alice"))

    (println "\nTesting add:")
    (println (add))
    (println (add 5))
    (println (add 3 4))
    (println (add 1 2 3))

    (println "\nMulti-arity defn with docstrings now works!")))
