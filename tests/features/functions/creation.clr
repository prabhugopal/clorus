;; Just create the multi-arity fn, don't call it
(def test-fn
  (fn
    ([x] (* x 10))
    ([x y] (+ x y))))

;; Return something else
42
;; Just create the closure, don't call it yet
(defn make-adder [x]
  (fn [y] (+ x y)))

;; Just create it
(def add-5 (make-adder 5))

;; Print something to show it compiled
"done"
