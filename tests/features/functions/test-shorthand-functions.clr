;; Test function shorthand #()

(defn -main []
  (do
    (println "Testing function shorthand #()...")

    ;; Test simple shorthand with %
    (let [double #(* % 2)]
      (do
        (if (= (double 5) 10)
          (println "✓ #(* % 2) works")
          (throw "simple shorthand failed"))))

    ;; Test numbered parameters %1 %2
    (let [add #(+ %1 %2)]
      (do
        (if (= (add 3 4) 7)
          (println "✓ #(+ %1 %2) works")
          (throw "numbered parameters failed"))))

    ;; Test with map
    (let [result (map #(* % 2) [1 2 3 4 5])]
      (do
        (if (= result [2 4 6 8 10])
          (println "✓ map with #() works")
          (throw "map with shorthand failed"))))

    ;; Test with filter
    (let [result (filter #(> % 3) [1 2 3 4 5 6])]
      (do
        (if (= result [4 5 6])
          (println "✓ filter with #() works")
          (throw "filter with shorthand failed"))))

    ;; Test three parameters
    (let [add3 #(+ %1 %2 %3)]
      (do
        (if (= (add3 1 2 3) 6)
          (println "✓ #(+ %1 %2 %3) works")
          (throw "three parameter shorthand failed"))))

    (println "")
    (println "✅ ALL FUNCTION SHORTHAND TESTS PASSED!")))
