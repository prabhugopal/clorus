(ns test-workaround)

;; Test workarounds for the let/when bug

(def active-field-atom (atom :name))

(println "=== Workaround 1: Using do instead of nested when ===")
(when true
  (println "Before do")
  (do
    (let [active-field @active-field-atom]
      (println "Inside let")
      (when (= active-field :name)
        (println "Name handler executed")))))

(println "\n=== Workaround 2: Using if instead of when ===")
(if true
  (let [active-field @active-field-atom]
    (println "Inside let with if")
    (when (= active-field :name)
      (println "Name handler with if executed")))
  nil)

(println "\n=== Workaround 3: No nested when - direct let ===")
(let [active-field @active-field-atom]
  (println "Direct let")
  (when (= active-field :name)
    (println "Name handler in direct let")))

(println "\n=== Workaround 4: Avoiding let - direct deref ===")
(when true
  (println "Before direct deref")
  (when (= @active-field-atom :name)
    (println "Name handler with direct deref")))
