;; Transducer utilities that supplement clorus.core.
;;
;; Collection transforms (`map`, `filter`, `take`, `drop`, `remove`,
;; `mapcat`, `partition-by`, `take-while`, and `drop-while`) live in core as
;; canonical multi-arity APIs. Keeping this file free of redefinitions makes
;; stdlib behavior independent of load order.

(defn cat [rf]
  (fn
    ([result] (rf result))
    ([result input]
     (reduce (fn [acc x]
               (let [next (rf acc x)]
                 (if (reduced? next) (unreduced next) next)))
             result
             input))))

(defn completing
  ([f] (completing f (fn [result] result)))
  ([f completion-fn]
   (fn
     ([result] (completion-fn result))
     ([result input] (f result input)))))

(defn transduce
  ([xform rf-fn coll]
   (transduce xform rf-fn [] coll))
  ([xform rf-fn init coll]
   (let [rf (xform rf-fn)
         result (reduce rf init coll)
         completed (rf result)]
     (if (nil? completed) result completed))))

(defn into
  ([to from] (reduce conj to from))
  ([to xform from] (transduce xform conj to from)))
